# ==============================================================================
# PATRIOTAINdica - Variáveis de Ambiente para HOMOLOGAÇÃO (Staging)
# ==============================================================================

# Projeto e Ambiente
PROJECT_NAME="Patriota Indica (Homologação)"
ENVIRONMENT="staging"
DEBUG=false

# Banco de Dados PostgreSQL + PostGIS (Isolado da Produção!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_postgres_pass_alterar
POSTGRES_DB=patriotaindica_staging
DATABASE_URL=postgresql+asyncpg://postgres:staging_postgres_pass_alterar@db-staging:5432/patriotaindica_staging
DATABASE_SYNC_URL=postgresql://postgres:staging_postgres_pass_alterar@db-staging:5432/patriotaindica_staging

# Redis Cache & Filas Staging (Isolado da Produção!)
# IMPORTANTE: REDIS_PASSWORD deve ser idêntica à senha informada em REDIS_URL
REDIS_PASSWORD=staging_redis_pass_alterar
REDIS_URL=redis://:staging_redis_pass_alterar@redis-staging:6379/0

# Segurança JWT (Gere com: openssl rand -hex 64)
# OBRIGATÓRIO: Chave diferente da produção!
JWT_SECRET_KEY=e123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend Next.js Staging
NEXT_PUBLIC_API_URL=/api/v1
PUBLIC_APP_URL=https://staging.patriotaindica.com.br

# Mercado Pago (MODO TESTE / SANDBOX)
# Use credenciais de teste obtidas no portal de desenvolvedores do Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
BILLING_MODE=per_owner

# Whitelist de Hosts para Homologação
ALLOWED_HOSTS=staging.patriotaindica.com.br,staging-api.patriotaindica.com.br,*.easypanel.host,localhost,127.0.0.1,backend
CORS_ORIGINS=https://staging.patriotaindica.com.br,http://localhost:3000
