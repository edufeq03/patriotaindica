# ==============================================================================
# PATRIOTAINdica - Variáveis de Ambiente
# ==============================================================================

# Projeto
PROJECT_NAME="Patriota Indica"
ENVIRONMENT="production"

# Banco de Dados PostgreSQL + PostGIS 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_sua_senha_segura
POSTGRES_DB=patriotaindica
DATABASE_URL=postgresql+asyncpg://postgres:postgres_sua_senha_segura@db:5432/patriotaindica
DATABASE_SYNC_URL=postgresql://postgres:postgres_sua_senha_segura@db:5432/patriotaindica

# Redis Cache & Filas (com autenticação em produção)
REDIS_URL=redis://:sua_senha_segura_redis@redis:6379/0

# Segurança JWT (Gere obrigatoriamente com: openssl rand -hex 64; >= 64 caracteres)
# Rejeita termos proibidos como sua_chave, dev_key, change, secret, example, exemplo
JWT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend Next.js
NEXT_PUBLIC_API_URL=/api/v1
PUBLIC_APP_URL=https://patriotaindica.com

# Mercado Pago (Pagamentos Reais: Pix, Cartão e Boleto)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-credencial_invalida_insira_sua_chave_real
MERCADO_PAGO_PUBLIC_KEY=APP_USR-credencial_invalida_insira_sua_chave_real

# Credenciais Administrativas do Operador (Altere para seu email e senha de preferência)
ADMIN_EMAIL=admin@patriotaindica.com.br
ADMIN_PASSWORD=admin123

