# ==============================================================================
# PATRIOTAINdica - Variáveis de Ambiente
# ==============================================================================

# Projeto
PROJECT_NAME="Patriota Indica"
ENVIRONMENT="production"

# Banco de Dados PostgreSQL + PostGIS 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_sua_senha_segura
POSTGRES_DB=patriotaindica
DATABASE_URL=postgresql+asyncpg://postgres:postgres_sua_senha_segura@db:5432/patriotaindica
DATABASE_SYNC_URL=postgresql://postgres:postgres_sua_senha_segura@db:5432/patriotaindica

# Redis Cache & Filas
REDIS_URL=redis://redis:6379/0

# Segurança JWT (gere uma chave aleatória de 32+ caracteres)
JWT_SECRET_KEY=sua_chave_secreta_super_segura_de_32_caracteres_minimo

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
