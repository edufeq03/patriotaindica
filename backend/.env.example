# Environment configuration for Curated Local Marketplace (MVP)
PROJECT_NAME="Patriota Indica"
ENVIRONMENT="development"
DEBUG=True

# Database PostgreSQL + PostGIS
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patriotaindica
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patriotaindica
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/patriotaindica

# Redis (filas, cache de geocoding e rate limiting)
REDIS_URL=redis://localhost:6379/0

# Security / JWT (Gere com: openssl rand -hex 64; >= 64 caracteres hexadecimais obrigatório)
# Rejeita termos como: sua_chave, dev_key, change, secret, example, exemplo
JWT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Third-Party External APIs
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# CORS Frontend URLs
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://patriotaindica.com"]

# Mercado Pago & Monetização (Pix e Cartão até 12x)
# Obtenha suas credenciais em: https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-credencial_mercadopago_invalida_substitua_aqui
MERCADO_PAGO_PUBLIC_KEY=APP_USR-credencial_mercadopago_invalida_substitua_aqui
BILLING_MODE=per_owner
PUBLIC_APP_URL=https://patriotaindica.com
